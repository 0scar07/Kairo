# Copia este archivo a .env y pon tu key de https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Opcionales ---
PORT=3000
# Región por defecto si la app no envía ?region= (la1, la2, na1, br1, euw1, eun1, tr1, kr, jp1, oc1...)
DEFAULT_REGION=la1
# Peticiones por minuto y por IP (un perfil completo hace ~14)
RATE_LIMIT_PER_MIN=240
# Orígenes web permitidos, separados por comas. Vacío = cualquiera. Las apps nativas no envian Origin
CORS_ORIGINS=
# Cuántos proxies hay delante (Render/Railway/Fly = 1). Por defecto: 1 en producción, 0 en local
# TRUST_PROXY=1
