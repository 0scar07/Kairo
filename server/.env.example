# Copia este archivo a .env y pon tu key de https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Opcionales ---
PORT=3000
# Región por defecto si la app no envía ?region= (la1, la2, na1, br1, euw1, eun1, tr1, kr, jp1, oc1...)
DEFAULT_REGION=la1
# Peticiones por minuto y por IP (un perfil completo hace ~14)
RATE_LIMIT_PER_MIN=240
# Orígenes web permitidos, separados por comas. Vacío = cualquiera. Las apps nativas no envian Origin
CORS_ORIGINS=
# Cuántos proxies hay delante (Render/Railway/Fly = 1). Por defecto: 1 en producción, 0 en local
# TRUST_PROXY=1
# Cupo de tu key hacia Riot, como "peticiones:segundos" separados por comas (por defecto "18:1,95:120", un poco por debajo de 20/s y 100/120 s)
# RIOT_RATE_LIMITS=18:1,95:120
# Cuenta pública que el servidor consulta cada 10 min para saber qué juegos habilita tu key ("Nombre#TAG@region")
# PROBE_RIOT_ID=Hide on bush#KR1@kr

# --- Notificaciones: registro de dispositivos ---
# Postgres (Neon, etc.): postgres://usuario:clave@host/base?sslmode=require . Sin esto se usa un archivo JSON en DATA_DIR
# (en Render gratis el disco se borra al reiniciar, por eso allí hace falta DATABASE_URL)
# DATABASE_URL=
# DATABASE_SSL=false          # solo para un Postgres local sin SSL
# DATA_DIR=./data
# MAX_DEVICES=5000

# --- Dota 2, Fortnite, Apex Legends y PUBG (opcionales; Dota 2 funciona sin key) ---
# OPENDOTA_API_KEY=            # opcional: sube los límites de OpenDota (opendota.com/api-keys)
# FORTNITE_API_KEY=            # gratuita, en dash.fortnite-api.com
# APEX_API_KEY=                # gratuita, en portal.apexlegendsapi.com
# PUBG_API_KEY=                # gratuita, en developer.pubg.com (10 peticiones/min)

# --- Supercell (opcionales: cada juego se activa al poner su key) ---
# Créalas en developer.brawlstars.com / developer.clashroyale.com / developer.clashofclans.com
# y permite la IP 45.79.218.79 (proxy de RoyaleAPI, que usan por defecto para tener una IP fija).
# BRAWLSTARS_API_KEY=
# CLASHROYALE_API_KEY=
# CLASHOFCLANS_API_KEY=
# Para usar la API oficial en vez del proxy (necesitas IP fija): BRAWLSTARS_API_BASE=https://api.brawlstars.com/v1
