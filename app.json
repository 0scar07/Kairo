{
  "expo": {
    "name": "Kairo",
    "slug": "kairo",
    "scheme": "kairo",
    "version": "1.5.0",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.camavingaaa.kairo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070C0F"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#070C0F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C89B3C",
          "defaultChannel": "live_start",
          "sounds": [
            "./assets/sounds/live_start.wav",
            "./assets/sounds/live_result.wav"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "./node_modules/@expo-google-fonts/sora/800ExtraBold/Sora_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "KairoRank",
              "label": "Kairo · Rango",
              "description": "Tu rango Solo/Dúo, LP y últimas partidas",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/rank.png"
            },
            {
              "name": "KairoMatch",
              "label": "Kairo · Próximo partido",
              "description": "El próximo partido de Valorant de tu equipo",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/match.png"
            },
            {
              "name": "KairoFriends",
              "label": "Kairo · Favoritos",
              "description": "Quién de tus favoritos está en partida",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/friends.png"
            }
          ]
        }
      ]
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070C0F",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Kairo",
      "shortName": "Kairo",
      "backgroundColor": "#070C0F",
      "themeColor": "#070C0F",
      "display": "standalone"
    },
    "extra": {
      "eas": {
        "projectId": "be7b143d-54cf-4f31-9e50-62eccfb267bc"
      }
    },
    "owner": "camavingaaa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be7b143d-54cf-4f31-9e50-62eccfb267bc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
