{
  "expo": {
    "name": "Kairo",
    "slug": "kairo",
    "scheme": "kairo",
    "version": "1.3.0",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.camavingaaa.kairo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070C0F"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#070C0F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C89B3C",
          "defaultChannel": "live_start",
          "sounds": [
            "./assets/sounds/live_start.wav",
            "./assets/sounds/live_result.wav"
          ]
        }
      ]
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070C0F",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Kairo",
      "shortName": "Kairo",
      "backgroundColor": "#070C0F",
      "themeColor": "#070C0F",
      "display": "standalone"
    },
    "extra": {
      "eas": {
        "projectId": "be7b143d-54cf-4f31-9e50-62eccfb267bc"
      }
    },
    "owner": "camavingaaa"
  }
}
